{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Copy this to .claude/settings.local.json (not committed) to override project defaults per-machine. Use this for: tighter restrictions on a shared dev machine, or relaxing the .env read-deny if you specifically need agents to read env vars (e.g., for deploy automation).",
  "permissions": {
    "allow": [
    ],
    "ask": [
      "Bash(vercel --prod:*)",
      "Bash(railway up:*)"
    ]
  }
}
