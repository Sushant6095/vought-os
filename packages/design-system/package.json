{
  "name": "@vought/design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical design tokens and Tailwind preset for Vought.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens": {
      "types": "./src/tokens.ts",
      "default": "./src/tokens.ts"
    },
    "./tailwind": {
      "types": "./tailwind.config.ts",
      "default": "./tailwind.config.ts"
    },
    "./global.css": "./src/global.css"
  },
  "files": [
    "src",
    "tailwind.config.ts",
    "README.md"
  ],
  "scripts": {
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.3"
  }
}
