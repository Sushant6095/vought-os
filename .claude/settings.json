{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-4-7",
  "permissions": {
    "defaultMode": "acceptEdits",
    "additionalDirectories": [],
    "allow": [
      "Read(**)",
      "Write(**)",
      "Edit(**)",
      "MultiEdit(**)",
      "NotebookEdit(**)",
      "Glob(**)",
      "Grep(**)",
      "TodoWrite",
      "Task(**)",
      "WebSearch",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(node:*)",
      "Bash(tsx:*)",
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(uv:*)",
      "Bash(uvicorn:*)",
      "Bash(huggingface-cli:*)",
      "Bash(ngrok:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(psql:*)",
      "Bash(createdb:*)",
      "Bash(redis-cli:*)",
      "Bash(ffmpeg:*)",
      "Bash(ffprobe:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(mkdir:*)",
      "Bash(rmdir:*)",
      "Bash(touch:*)",
      "Bash(chmod:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(jq:*)",
      "Bash(tar:*)",
      "Bash(unzip:*)",
      "Bash(tree:*)",
      "Bash(open:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git pull:*)",
      "Bash(git stash:*)",
      "Bash(git tag:*)",
      "Bash(git remote:*)",
      "Bash(git init)",
      "Bash(git config:*)",
      "Bash(gh:*)",
      "Bash(vercel:*)",
      "Bash(railway:*)",
      "Bash(flyctl:*)",
      "Bash(fly:*)",
      "Bash(modal:*)",
      "Bash(supabase:*)",
      "Bash(neon:*)",
      "Bash(playwright:*)",
      "Bash(lighthouse:*)",
      "Bash(unlighthouse:*)",
      "Bash(axe:*)",
      "WebFetch(domain:elevenlabs.io)",
      "WebFetch(domain:docs.elevenlabs.io)",
      "WebFetch(domain:platform.openai.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:huggingface.co)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:vercel.com)",
      "WebFetch(domain:railway.app)",
      "WebFetch(domain:neon.tech)",
      "WebFetch(domain:upstash.com)",
      "WebFetch(domain:observe.ai)",
      "WebFetch(domain:cresta.com)",
      "WebFetch(domain:stripe.com)",
      "WebFetch(domain:linear.app)"
    ],
    "ask": [],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf ~/Library:*)",
      "Bash(rm -rf ~/Documents:*)",
      "Bash(rm -rf ~/Desktop:*)",
      "Bash(rm -rf ../:*)",
      "Bash(rm -rf /etc:*)",
      "Bash(rm -rf /usr:*)",
      "Bash(rm -rf /var:*)",
      "Bash(rm -rf /System:*)",
      "Bash(sudo:*)",
      "Bash(curl:* | sh)",
      "Bash(curl:* | bash)",
      "Bash(wget:* | sh)",
      "Bash(wget:* | bash)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main --force:*)",
      "Bash(git reset --hard HEAD~:*)",
      "Bash(dropdb:*)",
      "Bash(psql:* DROP DATABASE:*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.*.local)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*credentials*)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/**)",
      "Read(~/.config/**)",
      "Write(**/.env)",
      "Write(**/.env.local)",
      "Write(**/.env.production)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.production)",
      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)",
      "Bash(yarn publish:*)",
      "Bash(vercel remove:*)",
      "Bash(railway down:*)",
      "Bash(railway delete:*)"
    ]
  },
  "env": {
    "VOUGHT_PROJECT_ROOT": "${workspaceFolder}",
    "VOUGHT_VAULT_PATH": "${workspaceFolder}/vault",
    "VOUGHT_BLUEPRINT_PATH": "${workspaceFolder}/VOUGHT-DESIGN-BLUEPRINT.md",
    "VOUGHT_AUTO_MODE": "1"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-write-check.sh \"$CLAUDE_FILE_PATH\" 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
