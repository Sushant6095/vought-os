# ─── ElevenLabs ────────────────────────────────────────────────
# Required. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required. The Speech Engine resource id returned from
#   pnpm --filter=echo-engine create-engine
SPEECH_ENGINE_ID=seng_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── LLM Providers (you only need one) ─────────────────────────
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Which provider to use ("openai" | "anthropic"). Default: openai.
LLM_PROVIDER=openai

# Which model. Defaults: gpt-4o-mini (openai) or claude-3-5-haiku-latest (anthropic).
LLM_MODEL=gpt-4o-mini

# Token + temperature budget. Whispers are short; keep them tight.
LLM_MAX_TOKENS=200
LLM_TEMPERATURE=0.7

# ─── Diarization sidecar ───────────────────────────────────────
# Where to receive speaker labels FROM the Python sidecar.
# When unset, defaults to ws://localhost:8000/labels.
DIARIZATION_WS_URL=ws://localhost:8000/labels

# ─── Datastores ────────────────────────────────────────────────
# Redis holds the per-session conversation memory (1h TTL).
REDIS_URL=redis://localhost:6379

# Postgres + pgvector holds the playbook chunks for Vox personas.
# Schema lives in database/schema.sql. RAG is disabled if unset.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/echo

# ─── Server ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# ─── Public URL for ElevenLabs to reach you (ngrok in dev) ─────
# Run:  ngrok http 3001
# Then set the wss:// equivalent here, with /ws path appended.
PUBLIC_WS_URL=wss://your-ngrok-id.ngrok-free.app/ws
